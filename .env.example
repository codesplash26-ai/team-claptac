ATLAS_ENV=dev
ATLAS_SCOPE="monitor and coordinate response for Ratnapura district"

# LLM (Anthropic). Falls back to ANTHROPIC_API_KEY if LLM_API_KEY is empty.
LLM_API_KEY=
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-4-20250514
LLM_MAX_RETRIES=3
LLM_REQUESTS_PER_MINUTE=30
LLM_TIMEOUT_SECONDS=60

# Storage
DATABASE_URL=sqlite:///./data/atlas.db

# External services
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
WEATHER_API_KEY=

# Hardware sensors (Raspberry Pi nodes)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=atlas/sensors/#

# Sentinel
ANOMALY_THRESHOLD=0.7
