ATLAS_ENV=dev
ATLAS_SCOPE="monitor and coordinate response for Ratnapura district"

# LLM
LLM_API_KEY=
LLM_MODEL=claude-sonnet-5
# LLM_MAX_RETRIES=3  LLM_REQUESTS_PER_MINUTE=30  LLM_TIMEOUT_SECONDS=60
# LLM_PROVIDER=anthropic   (or openai, as an optional fallback; OPENAI_API_KEY=)
# The loop runs without a key; the LLM only advises (never on the critical path).

# Which road network and shelters the API loads (ratnapura, kandy, colombo_fort)
ATLAS_SITE=ratnapura

# Storage
DATABASE_URL=sqlite:///./data/atlas.db

# External services
OPEN_ELEVATION_URL=https://api.open-elevation.com/api/v1/lookup
WEATHER_API_KEY=

# Hardware sensors (Raspberry Pi nodes)
MQTT_HOST=localhost
MQTT_PORT=1883
MQTT_TOPIC=atlas/sensors/#
MQTT_ENABLED=false

# Sentinel thresholds and planner budgets live in config/sentinel.yaml and config/reasoning.yaml.

# Control boundary: when set, approvals and mission updates need an X-Operator-Token header.
ATLAS_OPERATOR_TOKEN=

# LoRa link: shared HMAC key for frame signatures (32+ random bytes, hex). Never commit a real one.
LORA_HMAC_KEY=

# Agent manager access: a JSON list of {"token": ..., "name": ..., "role": ...}. Roles: admin, commander,
# developer, ai_lead, platform_engineer, viewer. With none set the API runs in open development mode.
ATLAS_TOKENS=
# ATLAS_AUTH=strict   reads need their permission too, even with only the single operator token
# Push traces to any OpenTelemetry collector (OTLP/HTTP), e.g. http://localhost:4318
ATLAS_OTLP_ENDPOINT=
# ATLAS_OTLP_HEADERS=authorization=Bearer ...
# Command line: ATLAS_URL=http://127.0.0.1:8000  ATLAS_TOKEN=<your token>

# Intelligence: offline mode is LLM_PROVIDER=none. Completed-cycle advice is cached in SQLite.
INTELLIGENCE_MAX_CALLS_PER_INCIDENT=4
# Advisory simulation only; does not change A3 actions or override approval gates.
INTELLIGENCE_PLANNER=false
# Optional custom location for private dashboard LLM settings (never commit the file).
# ATLAS_LLM_SETTINGS_PATH=/absolute/private/path/llm-settings.json
# Saved dashboard settings override environment provider/model defaults.
